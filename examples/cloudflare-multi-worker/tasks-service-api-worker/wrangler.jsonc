{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "livequery-tasks-service-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "TASKS_DB",
      "database_name": "livequery-tasks",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
