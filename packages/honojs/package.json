{
  "name": "@livequery/honojs",
  "author": "Duong Van Ba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flygo-opensource/livequery.git",
    "directory": "packages/honojs"
  },
  "version": "3.0.0",
  "description": "Hono adapter for @livequery ecosystem",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/**/*",
    "!build/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "test": "bun test tests/",
    "build": "tsc -b ."
  },
  "exports": {
    ".": {
      "workerd": {
        "types": "./build/src/runtime/workers.d.ts",
        "default": "./build/src/runtime/workers.js"
      },
      "bun": {
        "types": "./build/src/runtime/bun.d.ts",
        "default": "./build/src/runtime/bun.js"
      },
      "node": {
        "types": "./build/src/runtime/node.d.ts",
        "default": "./build/src/runtime/node.js"
      },
      "default": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    },
    "./bun": {
      "types": "./build/src/bun.d.ts",
      "default": "./build/src/bun.js"
    },
    "./node": {
      "types": "./build/src/node.d.ts",
      "default": "./build/src/node.js"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "x",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "hono": "^4.12.21",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@livequery/core": "^3.0.0",
    "rxjs": "x"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "homepage": "https://github.com/flygo-opensource/livequery/tree/main/packages/honojs#readme",
  "bugs": {
    "url": "https://github.com/flygo-opensource/livequery/issues"
  }
}
