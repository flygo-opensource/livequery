    "type": "module",
    "repository": {
        "url": "git@github.com:livequery/mongodb.git"
    },
    "version": "2.0.145",
    "description": "MongoDB datasource mapping for @livequery ecosystem",
    "main": "./build/src/index.js",
    "types": "./build/src/index.d.ts",
    "files": [
        "build/**/*"
    ],
