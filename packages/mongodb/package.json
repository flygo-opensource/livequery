        "mongodb": "^6.20.0",
        "rxjs": "*",
        "typescript": "*" 
    },
    "scripts": {
        "test": "bun test",
        "build": "rm -rf build; tsc -b .",
        "deploy": "rm -rf build && yarn build; git add .; git commit -m \"Update\"; git push origin master; npm publish --access public"
    },
    "peerDependencies": {
        "bson": "*",
        "mongodb": "^6.20.0"
    }
