{
  "name": "@livequery/rest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flygo-opensource/livequery.git",
    "directory": "packages/rest"
  },
  "version": "3.0.1",
  "type": "module",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./RestTransporter": {
      "types": "./dist/RestTransporter.d.ts",
      "import": "./dist/RestTransporter.js",
      "default": "./dist/RestTransporter.js"
    },
    "./Socket": {
      "types": "./dist/Socket.d.ts",
      "import": "./dist/Socket.js",
      "default": "./dist/Socket.js"
    },
    "./helpers/parseJson": {
      "types": "./dist/helpers/parseJson.d.ts",
      "import": "./dist/helpers/parseJson.js",
      "default": "./dist/helpers/parseJson.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist/**/*"
  ],
  "devDependencies": {
    "@livequery/client": "^3.0.0",
    "typescript": "5.6.3"
  },
  "peerDependencies": {
    "@livequery/client": "^3.0.0",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "test": "bun test",
    "build": "bun run clean && bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "bun run build"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0"
  },
  "homepage": "https://github.com/flygo-opensource/livequery/tree/main/packages/rest#readme",
  "bugs": {
    "url": "https://github.com/flygo-opensource/livequery/issues"
  }
