{
  "name": "@livequery/core",
  "author": "Duong Van Ba",
  "license": "MIT",
  "repository": {
    "url": "git@github.com:livequery/core.git"
  },
  "version": "3.0.0",
  "description": "Livequery protocol, realtime gateway and runtime adapters (Node, Bun, Cloudflare Workers)",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/**/*",
    "LIVEQUERY_SPEC.md"
  ],
  "scripts": {
    "test": "bun test tests/",
    "build": "tsc -b .",
    "deploy": "yarn build; git add .; git commit -m \"Update\"; git push origin master; npm publish --access public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./build/src/node.d.ts",
        "default": "./build/src/node.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./build/src/bun.d.ts",
        "default": "./build/src/bun.js"
      }
    },
    "./workers": {
      "import": {
        "types": "./build/src/workers.d.ts",
        "default": "./build/src/workers.js"
      }
    },
    "./udp": {
      "import": {
        "types": "./build/src/udp.d.ts",
        "default": "./build/src/udp.js"
      }
    }
  },
  "type": "module",
  "devDependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@ohayo/udp": "^3.0.0",
    "@types/bun": "latest",
    "@types/node": "x",
    "@types/ws": "^8",
    "hono": "^4.12.21",
    "msgpackr": "^1.11.9",
    "typescript": "^5.1.6",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "rxjs": "x"
  },
  "peerDependencies": {
    "@ohayo/udp": "^3.0.0",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@ohayo/udp": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
