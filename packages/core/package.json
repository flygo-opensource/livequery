{
  "name": "@livequery/core",
  "author": "Duong Van Ba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flygo-opensource/livequery.git",
    "directory": "packages/core"
  },
  "version": "3.0.1",
  "description": "Livequery protocol, realtime gateway and runtime adapters (Node, Bun, Cloudflare Workers)",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/**/*",
    "LIVEQUERY_SPEC.md",
    "!build/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "test": "bun test tests/",
    "build": "tsc -b ."
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./build/src/node.d.ts",
        "default": "./build/src/node.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./build/src/bun.d.ts",
        "default": "./build/src/bun.js"
      }
    },
    "./workers": {
      "import": {
        "types": "./build/src/workers.d.ts",
        "default": "./build/src/workers.js"
      }
    }
  },
  "type": "module",
  "devDependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@types/bun": "latest",
    "@types/node": "x",
    "@types/ws": "^8",
    "hono": "^4.12.21",
    "msgpackr": "^1.11.9",
    "typescript": "^5.1.6",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "rxjs": "x"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "homepage": "https://github.com/flygo-opensource/livequery/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/flygo-opensource/livequery/issues"
  }
}
