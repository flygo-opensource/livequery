{
  "name": "@livequery/core",
  "author": "Duong Van Ba",
  "license": "MIT",
  "repository": {
    "url": "git@github.com:livequery/core.git"
  },
  "version": "3.0.0",
  "description": "Framework-agnostic core utilities for @livequery ecosystem",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/**/*",
    "LIVEQUERY_SPEC.md"
  ],
  "scripts": {
    "test": "bun test tests/",
    "build": "tsc -b .",
    "deploy": "yarn build; git add .; git commit -m \"Update\"; git push origin master; npm publish --access public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./build/src/index.d.ts",
        "default": "./build/src/index.js"
      }
    },
    "./protocol": {
      "import": {
        "types": "./build/src/protocol.d.ts",
        "default": "./build/src/protocol.js"
      }
    },
    "./service": {
      "import": {
        "types": "./build/src/service.d.ts",
        "default": "./build/src/service.js"
      }
    },
    "./discovery": {
      "import": {
        "types": "./build/src/discovery-entry.d.ts",
        "default": "./build/src/discovery-entry.js"
      }
    },
    "./gateway": {
      "import": {
        "types": "./build/src/gateway.d.ts",
        "default": "./build/src/gateway.js"
      }
    },
    "./realtime": {
      "import": {
        "types": "./build/src/realtime.d.ts",
        "default": "./build/src/realtime.js"
      }
    },
    "./node": {
      "import": {
        "types": "./build/src/node.d.ts",
        "default": "./build/src/node.js"
      }
    },
    "./bun": {
      "import": {
        "types": "./build/src/bun.d.ts",
        "default": "./build/src/bun.js"
      }
    },
    "./workers": {
      "import": {
        "types": "./build/src/workers.d.ts",
        "default": "./build/src/workers.js"
      }
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "x",
    "@types/ws": "^8",
    "hono": "^4.12.21",
    "msgpackr": "^1.11.9",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@livequery/discovery": "^3.0.0",
    "@livequery/gateway": "^3.0.0",
    "@livequery/protocol": "^3.0.0",
    "@livequery/realtime": "^3.0.0",
    "@livequery/realtime-cloudflare": "^3.0.0",
    "@livequery/service": "^3.0.0",
    "@ohayo/udp": "^3.0.0",
    "rxjs": "x",
    "ws": "^8.18.0"
  }
}
